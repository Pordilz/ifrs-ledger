# Get an API key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the Gemini model.
# Free-tier keys can ONLY use Flash models (Pro models return a "limit: 0" quota
# error on the free tier). The default below works on the free tier.
# Pin to a stable GA model (e.g. gemini-2.5-flash) if you don't want the moving alias.
GEMINI_MODEL=gemini-flash-latest

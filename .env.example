# Get an API key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the Gemini model.
#
# You usually do NOT need this. The app tries a chain of models and fails over
# automatically when one is busy:
#   gemini-2.5-flash  ->  gemini-flash-latest  ->  gemini-3.5-flash-lite
#
# Setting GEMINI_MODEL puts your choice FIRST; the chain above still backs it up.
# Free-tier keys can only use Flash models — Pro models return a "limit: 0"
# quota error. Set this to a Pro model only if your key is on a paid plan.
# GEMINI_MODEL=gemini-2.5-flash
